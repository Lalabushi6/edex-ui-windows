# Dependencies — restored via `npm install`, never committed. Vendoring them
# pins unauditable prebuilt binaries (node-pty ships compiled .node artifacts)
# into history and makes supply-chain review impractical.
node_modules/

# Build output
dist/
dist-smoke/
out/
*.asar

# Local copy of the pre-rebuild (v1) source
.backup/

# Runtime state
.edex-ui-settings.json
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
