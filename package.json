{
  "name": "edex-ui-windows",
  "productName": "eDEX-UI",
  "version": "2.0.0",
  "description": "A sci-fi desktop shell for Windows: launcher, window dock, terminal, file explorer and live system telemetry in one full-screen overlay.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set EDEX_DEV_WINDOWED=1&& electron .",
    "check": "node scripts/check.js",
    "icons": "node scripts/make-icons.js",
    "build": "electron-builder build --windows"
  },
  "build": {
    "appId": "com.edex-ui.windows",
    "productName": "eDEX-UI",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "themes/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [
    "edex",
    "shell",
    "launcher",
    "terminal",
    "electron",
    "windows"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.31.5"
  }
}
